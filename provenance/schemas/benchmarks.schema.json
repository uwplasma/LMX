{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uwplasma/lmx/provenance/benchmarks.schema.json",
  "title": "LMX benchmark provenance registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "benchmarks"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/benchmark"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "availability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["article", "book", "technical_report", "repository", "repository_document"]},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900},
        "doi": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "report": {"type": "string", "minLength": 1},
        "availability": {"enum": ["repository", "external", "missing"]},
        "path": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tier", "title", "status", "source_ids", "primary_observables", "acceptance", "tests", "workflows", "runtime_lane"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][0-9](?:-[a-z0-9-]+)?$"},
        "tier": {"enum": ["A", "B", "C", "D", "E"]},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified-bounded", "comparison-open", "specification-open", "specification-frozen", "deferred"]},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "spec_path": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "primary_observables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptance": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runtime_lane": {"enum": ["portable-full", "external-data", "freemhd", "accelerator", "scaling"]},
        "open_reason": {"type": "string", "minLength": 1},
        "production_blocker": {"type": "string", "minLength": 1}
      }
    }
  }
}
