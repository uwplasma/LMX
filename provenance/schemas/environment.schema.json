{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uwplasma/lmx/provenance/environment.schema.json",
  "title": "LMX reproducible environment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "project",
    "python",
    "dependencies",
    "lock",
    "numerical_policy",
    "portable_gate",
    "repository_inventory"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_by": {"const": "scripts/manage_provenance.py"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "ci_tested"],
      "properties": {
        "requires": {"type": "string", "minLength": 1},
        "ci_tested": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^3\\.[0-9]+$"}
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      },
      "required": ["runtime", "dev", "docs"]
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "sha256", "version", "revision"],
      "properties": {
        "format": {"const": "uv"},
        "path": {"const": "uv.lock"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "numerical_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jax_enable_x64"],
      "properties": {"jax_enable_x64": {"type": "boolean"}}
    },
    "portable_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "budget_seconds", "warning_seconds", "default_workers", "branch_coverage_percent"],
      "properties": {
        "command": {"const": "python scripts/run_full_test_suite.py"},
        "budget_seconds": {"type": "integer", "minimum": 1},
        "warning_seconds": {"type": "integer", "minimum": 1},
        "default_workers": {"type": "integer", "minimum": 1},
        "branch_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "repository_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "tests", "examples", "scripts", "benchmark_specs"],
      "properties": {
        "modules": {"$ref": "#/$defs/pathList"},
        "tests": {"$ref": "#/$defs/pathList"},
        "examples": {"$ref": "#/$defs/pathList"},
        "scripts": {"$ref": "#/$defs/pathList"},
        "benchmark_specs": {"$ref": "#/$defs/pathList"}
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
