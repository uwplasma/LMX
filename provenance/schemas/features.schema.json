{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uwplasma/lmx/provenance/features.schema.json",
  "title": "LMX feature-to-evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {"const": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "claim", "modules", "tests", "workflows"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["stable", "research", "deferred"]},
        "claim": {"type": "string", "minLength": 1},
        "modules": {"$ref": "#/$defs/pathList"},
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "verification", "workflow"],
          "properties": {
            "unit": {"$ref": "#/$defs/pathList"},
            "verification": {"$ref": "#/$defs/pathList"},
            "workflow": {"$ref": "#/$defs/pathList"}
          }
        },
        "workflows": {"$ref": "#/$defs/pathList"}
      }
    }
  }
}
